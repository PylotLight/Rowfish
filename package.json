{
  "name": "rowfish",
  "version": "0.2.0-beta.3",
  "description": "A desktop PostgreSQL, SQLite and MongoDB client built with Electron, React and TypeScript",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:bare": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron ./out/main/index.js",
    "preview": "electron-vite preview",
    "clean": "rm -rf out release",
    "test": "bun test",
    "typecheck": "bun check",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:ci": "electron-builder --publish never --mac",
    "postinstall": "install-electron",
    "test:smoke": "bun run build && node scripts/sqlite-worker-smoke.mjs && node scripts/workbench-smoke.mjs && node scripts/modern-workbench-smoke.mjs && node scripts/settings-smoke.mjs && node scripts/query-connection-smoke.mjs && node scripts/layout-smoke.mjs && node scripts/results-view-smoke.mjs",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "build": {
    "appId": "com.pylotlight.rowfish",
    "productName": "Rowfish",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "46.0.0-alpha.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.9.0"
  }
}
